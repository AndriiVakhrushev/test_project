# ──────────────────────────────────────────────────────────────────────────────
# Ghost Blog — Hetzner + Tailscale Deployer  Environment
# ──────────────────────────────────────────────────────────────────────────────
# The deploy script reads ALL its configuration from this file.
# To use:
#   1. Copy this file to `.env` in the same directory as the deploy script:
#        cp scripts/.env.example scripts/.env
#   2. Fill in the values below.
#   3. Run the script:  ./deploy-ghost-hetzner.sh
#
# ⚠️ This file contains secrets. Do NOT commit it to version control.
# Use `.env.example` as a safe template to share.
# Note: `/scripts/.env` is already excluded in the repo's .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# --- Required credentials ---

# Hetzner Cloud API token
# Generate at: https://console.hetzner.cloud → your project → Security → API Tokens
HCLOUD_TOKEN=

# Tailscale auth key (ephemeral, reusable, or pre-auth key)
# Generate at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=

# --- Required configuration ---

# Public domain where Ghost will be served (e.g. blog.example.com)
# DNS A record for this domain must point to the server's public IP.
DOMAIN=

# --- Optional configuration (defaults applied if left empty) ---

# Hetzner server name (default: ghost-blog)
SERVER_NAME=ghost-blog

# Hetzner server type (default: cx22)
# See: https://www.hetzner.com/cloud
SERVER_TYPE=cx22

# Hetzner server location (default: fsn1)
# Options: fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki), ash (Ashburn)
SERVER_LOCATION=fsn1

# Path to your SSH public key.
# If empty, the script auto-detects ~/.ssh/id_ed25519.pub, id_rsa.pub, id_ecdsa.pub.
SSH_KEY_PATH=

# Ghost blog version (default: 5.113.2)
GHOST_VERSION=

# MySQL database version (default: 8.0)
MYSQL_VERSION=

# Caddy image version (default: 2-alpine)
CADDY_VERSION=
